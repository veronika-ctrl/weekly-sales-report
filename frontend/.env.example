# Copy to frontend/.env.local for local Next.js.

# --- HTTP Basic Auth (shared password for internal review) ---
# Set these in Vercel → Project Settings → Environment Variables for
# Production AND Preview, then Redeploy. Do not commit real passwords.
#
# Username example (override if you want):
SITE_BASIC_AUTH_USER=ohjay
# Required. Choose a long random password in the Vercel dashboard — not here.
SITE_BASIC_AUTH_PASSWORD=
# Optional alias if you prefer a single password variable instead:
# SITE_PASSWORD=

# Local `next dev` skips the gate when SITE_BASIC_AUTH_PASSWORD / SITE_PASSWORD
# are unset. Vercel production always requires auth (401 if the password is missing).

# --- Existing frontend flags ---
# NEXT_PUBLIC_DISABLE_SUPABASE=true skips Supabase week-data login only.
# It does NOT bypass HTTP Basic Auth.
# NEXT_PUBLIC_API_URL=
# Local Next: same-origin (rewrites /api → 127.0.0.1:8000) or http://127.0.0.1:8000
# Vercel Production: must be the persistent FastAPI URL, e.g.
# NEXT_PUBLIC_API_URL=https://weekly-sales-report.onrender.com
# Do not set same-origin or localhost on Vercel — uploads will not persist.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
